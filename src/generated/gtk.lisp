(rt:define-gfunction (tree-drag-dest-drag-data-received "gtk_tree_drag_dest_drag_data_received")
                     :args
                     ((drag-dest (:object tree-drag-dest))
                      (dest (:boxed "GtkTreePath" "gtk_tree_path_get_type"))
                      (value (:boxed "GValue" "g_value_get_type" gobject:value)))
                     :return :boolean :documentation
                     "Asks the `GtkTreeDragDest` to insert a row before the path DEST,
deriving the contents of the row from VALUE. If DEST is
outside the tree so that inserting before it is impossible, false
will be returned. Also, false may be returned if the new row is
not created for some model-specific reason.  Should robustly handle
a DEST no longer found in the model!

C: gtk_tree_drag_dest_drag_data_received
See: https://docs.gtk.org/gtk4/method.TreeDragDest.drag_data_received.html
Deprecated.")


(rt:define-gfunction (tree-drag-dest-row-drop-possible "gtk_tree_drag_dest_row_drop_possible")
                     :args
